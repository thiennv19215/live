{
  "name": "tiktok-live-output",
  "version": "1.2.0",
  "private": true,
  "description": "React and Electron control room for TikTok Live Studio",
  "author": "TikTok Live Control Room",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "io.streamtoearn.tiktok-live-output",
    "productName": "TikTok Live Control Room",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend-process.js",
      "preload.js",
      "window-options.js",
      "renderer/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/TikTokLiveBackend",
        "to": "TikTokLiveBackend"
      },
      {
        "from": "../gift_config.json",
        "to": "gift_config.json"
      },
      {
        "from": "../action_presets.json",
        "to": "action_presets.json"
      },
      {
        "from": "../videos",
        "to": "videos"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TikTokLiveStudio_Setup_v${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TikTok Live Control Room",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "esbuild@0.25.12": true
  }
}
